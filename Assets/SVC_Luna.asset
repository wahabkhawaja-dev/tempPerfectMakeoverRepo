            * vs_COLOR0.xyz + u_xlat0.xyz;\n    u_xlat1.xyz = u_xlat16_1.xyz * vs_COLOR0.xyz;\n   
            u_xlat16_3 = u_xlat16_1.w * vs_COLOR0.w + (-_Alpha);\n    SV_Target0.w
            = u_xlat16_3;\n    SV_Target0.xyz = u_xlat0.www * u_xlat0.xyz + u_xlat1.xyz;\n   
            return;\n}\n\n"

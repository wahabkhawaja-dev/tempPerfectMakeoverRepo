            vec2(-0.0500000007, 0.0199999996);\n    u_xlat6 = (-u_xlat0.x) * 20.0
            + 46.0999985;\n    u_xlat6 = sin(u_xlat6);\n    u_xlat1.xyz = u_xlat0.xyy
            * vec3(20.0, 20.0, 50.0) + vec3(46.0999985, 46.0999985, 46.0999985);\n   
            u_xlat16_0.xyw = texture(_MainTex, u_xlat0.xy).xyz;\n    u_xlat0.x =
            dot(u_xlat16_0.xyw, vec3(11.1999998, 8.39999962, 4.19999981));\n    u_xlat1.xyz
            = sin(u_xlat1.xyz);\n    u_xlat3.x = u_xlat6 + u_xlat1.x;\n    u_xlat3.x
            = u_xlat1.y + u_xlat3.x;\n    u_xlat3.x = u_xlat1.z + u_xlat3.x;\n   
            u_xlat3.x = u_xlat3.x + 5.0;\n    u_xlat6 = u_xlat3.x * 0.200000003;\n   

            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tvec4 _Time;\nuniform \tfloat _Distortion;\nuniform
            \tmediump float _Alpha;\nuniform \tfloat _Speed;\nuniform \tfloat EValue;\nuniform
            \tfloat TValue;\nuniform \tmediump vec4 Lightcolor;\nuniform \tfloat
            Light;\nUNITY_LOCATION(0) uniform mediump sampler2D _MainTex;\nUNITY_LOCATION(1)
            uniform mediump sampler2D _MainTex2;\nUNITY_LOCATION(2) uniform mediump
            sampler2D _GrabTexture;\nin mediump vec2 vs_TEXCOORD0;\nin mediump vec2
            vs_TEXCOORD1;\nin mediump vec4 vs_COLOR0;\nlayout(location = 0) out highp
            vec4 SV_Target0;\nvec3 u_xlat0;\nmediump vec4 u_xlat16_0;\nvec2 u_xlat1;\nmediump

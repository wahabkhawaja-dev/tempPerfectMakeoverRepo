            1.0;\n    u_xlat1.y = u_xlat16_2 * u_xlat1.x + u_xlat12;\n    u_xlat12
            = (-u_xlat8.x) + vs_TEXCOORD0.x;\n    u_xlat1.x = u_xlat16_2 * u_xlat12
            + u_xlat8.x;\n    u_xlat8.xy = u_xlat1.xy + vec2(-0.5, -0.5);\n    u_xlat8.xy
            = u_xlat8.xy * vec2(vec2(_Inside, _Inside)) + vec2(0.5, 0.5);\n    u_xlat16_1
            = texture(_MainTex, u_xlat8.xy);\n    u_xlat1 = u_xlat16_1 * vs_COLOR0;\n   
            u_xlat8.x = (-u_xlat4) + vs_TEXCOORD0.x;\n    u_xlat3.x = u_xlat16_2
            * u_xlat8.x + u_xlat4;\n    u_xlat4 = (-u_xlat0.x) + vs_TEXCOORD0.y;\n   
            u_xlat3.y = u_xlat16_2 * u_xlat4 + u_xlat0.x;\n    u_xlat16_0 = texture(_MainTex,
            u_xlat3.xy);\n    u_xlat0.xyz = u_xlat16_0.xyz * vs_COLOR0.xyz;\n   
            SV_Target0.w = u_xlat16_0.w * vs_COLOR0.w + (-_Alpha);\n    u_xlat3.xyz
            = u_xlat1.www * u_xlat0.xyz;\n    u_xlat0.xyz = u_xlat3.xyz * vec3(-0.5,
            -0.5, -0.5) + u_xlat0.xyz;\n    u_xlat12 = (-_Inside) + 3.0;\n    u_xlat1.xyz
            = u_xlat1.xyz / vec3(u_xlat12);\n    SV_Target0.xyz = u_xlat1.xyz * u_xlat1.www
            + u_xlat0.xyz;\n    return;\n}\n\n"

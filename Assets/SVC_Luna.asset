            layout(std140)\n#endif\nuniform \tfloat _Distortion;\nuniform \tfloat
            _Deep;\nuniform \tmediump float _Alpha;\nUNITY_LOCATION(0) uniform mediump
            sampler2D _MainTex;\nin mediump vec2 vs_TEXCOORD0;\nlayout(location =
            0) out highp vec4 SV_Target0;\nvec4 u_xlat0;\nmediump vec4 u_xlat16_0;\nvec3
            u_xlat1;\nmediump vec4 u_xlat16_1;\nmediump float u_xlat16_2;\nvec2 u_xlat3;\nmediump
            vec3 u_xlat16_3;\nmediump float u_xlat16_5;\nfloat u_xlat6;\nbool u_xlatb6;\nmediump

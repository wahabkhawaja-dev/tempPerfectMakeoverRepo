            u_xlat0.xy = vs_TEXCOORD0.xy + (-_FoldOrigin.xy);\n    u_xlat0.x = dot(u_xlat0.xy,
            vec2(_FoldDir.x, _FoldDir.y));\n    u_xlat3.x = _FoldDist * 0.5;\n   
            u_xlati3 = int((u_xlat3.x<u_xlat0.x) ? 0xFFFFFFFFu : uint(0));\n    u_xlatb6.x
            = _IsBack<0.5;\n    if(u_xlatb6.x){\n        u_xlati6 = op_not(u_xlati3);\n       
            if((u_xlati6)!=0){discard;}\n        u_xlat16_1 = texture(_MainTex, vs_TEXCOORD0.xy);\n       
            u_xlat6 = (-_FoldDist) * 0.5 + u_xlat0.x;\n        u_xlat6 = u_xlat6
            * 12.5;\n        u_xlat6 = clamp(u_xlat6, 0.0, 1.0);\n        u_xlat9
            = u_xlat6 * -2.0 + 3.0;\n        u_xlat6 = u_xlat6 * u_xlat6;\n       

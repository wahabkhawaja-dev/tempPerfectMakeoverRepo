            0.454544991;\n    u_xlat16_0.x = exp2(u_xlat16_0.x);\n    u_xlat16_3.x
            = u_xlat1.y * 50.0;\n    u_xlat16_3.x = clamp(u_xlat16_3.x, 0.0, 1.0);\n   

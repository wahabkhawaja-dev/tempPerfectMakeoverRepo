            = u_xlat16_1 * vs_COLOR0 + vec4(-0.0649999976, -0.0649999976, -0.0649999976,
            -0.00999999978);\n    u_xlat2 = u_xlat16_2 * vs_COLOR0 + vec4(-0.129999995,
            -0.129999995, -0.129999995, -0.00999999978);\n    u_xlat3 = (-u_xlat2.w)
            + 1.0;\n    u_xlat2 = u_xlat2.wwww * u_xlat2;\n    u_xlat0 = u_xlat0
            * vec4(u_xlat3) + u_xlat2;\n    u_xlat2.x = (-u_xlat1.w) + 1.0;\n   
            u_xlat1 = u_xlat1.wwww * u_xlat1;\n    u_xlat0 = u_xlat0 * u_xlat2.xxxx
            + u_xlat1;\n    u_xlat1.yz = vs_TEXCOORD0.xy + vec2(0.600000024, 0.0299999993);\n   

            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tfloat _Distortion;\nuniform \tfloat
            _PosX;\nuniform \tfloat _PosY;\nuniform \tmediump float _Alpha;\nUNITY_LOCATION(0)
            uniform mediump sampler2D _MainTex;\nin mediump vec2 vs_TEXCOORD0;\nin
            mediump vec4 vs_COLOR0;\nlayout(location = 0) out highp vec4 SV_Target0;\nvec4
            u_xlat0;\nmediump vec4 u_xlat16_0;\nvec2 u_xlat1;\nvec3 u_xlat2;\nmediump
            float u_xlat16_3;\nvec2 u_xlat4;\nfloat u_xlat12;\nbool u_xlatb12;\nvoid
            main()\n{\n    u_xlat0.x = sin(_Distortion);\n    u_xlat4.xy = vs_TEXCOORD0.xy
            + (-vec2(_PosX, _PosY));\n    u_xlat12 = dot(u_xlat4.xy, u_xlat4.xy);\n   
            u_xlat12 = sqrt(u_xlat12);\n    u_xlat1.x = (-u_xlat12) + 0.5;\n    u_xlatb12
            = u_xlat12<0.5;\n    u_xlat1.x = u_xlat1.x + u_xlat1.x;\n    u_xlat1.x
            = u_xlat1.x * u_xlat1.x;\n    u_xlat0.x = u_xlat0.x * u_xlat1.x;\n   
            u_xlat0.x = u_xlat0.x * 16.0;\n    u_xlat1.x = cos(u_xlat0.x);\n    u_xlat0.x
            = sin(u_xlat0.x);\n    u_xlat2.x = (-u_xlat0.x);\n    u_xlat2.y = u_xlat1.x;\n   
            u_xlat2.z = u_xlat0.x;\n    u_xlat1.y = dot(u_xlat4.yx, u_xlat2.yz);\n   
            u_xlat1.x = dot(u_xlat4.yx, u_xlat2.xy);\n    u_xlat0.xy = (bool(u_xlatb12))

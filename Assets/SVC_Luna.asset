            * u_xlat0.xxxx + u_xlat1;\n    u_xlat1 = hlslcc_mtx4x4unity_MatrixVP[2]
            * u_xlat0.zzzz + u_xlat1;\n    u_xlat0 = hlslcc_mtx4x4unity_MatrixVP[3]
            * u_xlat0.wwww + u_xlat1;\n    u_xlat1.xyz = u_xlat0.xyw * vec3(0.5,
            0.5, 0.5);\n    u_xlat1.xy = u_xlat1.zz + u_xlat1.xy;\n    vs_TEXCOORD1.xy
            = u_xlat1.xy / u_xlat0.ww;\n    gl_Position = u_xlat0;\n    vs_TEXCOORD0.xy

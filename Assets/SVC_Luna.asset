            u_xlat4;\nvec3 u_xlat6;\nmediump float u_xlat16_8;\nfloat u_xlat12;\nmediump
            float u_xlat16_12;\nvoid main()\n{\n    u_xlat0.x = _Time.x * _Speed;\n   
            u_xlat1.x = vs_TEXCOORD0.x * 0.166666672 + u_xlat0.x;\n    u_xlat0.xyz
            = u_xlat0.xxx * vec3(6.0, 8.0, 4.0);\n    u_xlat1.y = vs_TEXCOORD0.y
            * 0.166666672 + u_xlat0.z;\n    u_xlat16_8 = texture(_MainTex2, u_xlat1.xy).x;\n   
            u_xlat16_1 = texture(_MainTex, vs_TEXCOORD0.xy);\n    u_xlat0.xy = u_xlat16_1.ww
            * u_xlat16_1.xx + u_xlat0.xy;\n    u_xlat2.y = u_xlat0.x + vs_TEXCOORD0.y;\n   
            u_xlat2.w = u_xlat0.x + u_xlat2.y;\n    u_xlat0.y = u_xlat0.y + u_xlat2.w;\n   
            u_xlat2.xz = vs_TEXCOORD0.xx;\n    u_xlat16_12 = texture(_MainTex2, u_xlat2.zw).y;\n   
            u_xlat16_2 = texture(_MainTex2, u_xlat2.xy).x;\n    u_xlat12 = u_xlat16_12
            + u_xlat16_2;\n    u_xlat0.x = vs_TEXCOORD0.x;\n    u_xlat16_0.x = texture(_MainTex2,
            u_xlat0.xy).z;\n    u_xlat0.x = u_xlat16_0.x + u_xlat12;\n    u_xlat4
            = u_xlat0.x * 0.333333343 + u_xlat16_8;\n    u_xlat0.x = u_xlat0.x *
            _Distortion;\n    u_xlat0.xz = (-u_xlat0.xx) * vec2(0.00520833349, 0.00520833349)
            + vs_TEXCOORD1.xy;\n    u_xlat0.xz = (-vec2(u_xlat4)) * vec2(0.015625,
            0.015625) + u_xlat0.xz;\n    u_xlat0.xz = u_xlat0.xz + (-vs_TEXCOORD1.xy);\n   
            u_xlat0.xz = vec2(_Alpha) * u_xlat0.xz + vs_TEXCOORD1.xy;\n    u_xlat16_0.xzw
            = texture(_GrabTexture, u_xlat0.xz).xyz;\n    u_xlat2.x = u_xlat4 * Light;\n   
            u_xlat4 = max(u_xlat4, 0.600000024);\n    u_xlat4 = min(u_xlat4, 1.0);\n   
            u_xlat4 = u_xlat4 + -0.600000024;\n    u_xlat6.xyz = u_xlat16_1.xyz *
            vec3(Light);\n    u_xlat6.xyz = u_xlat6.xyz * Lightcolor.xyz;\n    u_xlat2.xyz
            = u_xlat2.xxx * Lightcolor.xyz + u_xlat6.xyz;\n    u_xlat2.xyz = vec3(u_xlat4)
            + u_xlat2.xyz;\n    u_xlat3.xyz = Lightcolor.xyz * Lightcolor.www;\n   
            u_xlat0.xyz = u_xlat16_0.xzw * vs_COLOR0.xyz + u_xlat3.xyz;\n    u_xlat0.xyz
